# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.

# The server connects to PostgreSQL purely through this URL — Docker or native
# Postgres both work, because Prisma does not care where the DB runs. It only
# needs a reachable PostgreSQL at this address with these credentials.

# --- Option A: Docker (default) ---
# Starts the DB with  docker compose up -d  (user/pass/db match docker-compose.yml).
#
# The Compose DB is published on host port 5433, NOT 5432, so it can coexist
# with a native Windows PostgreSQL service that already listens on 5432.
# Always use 127.0.0.1 rather than "localhost" — on Windows localhost may
# resolve to ::1 first, which can reach the native Postgres instead of Docker.
DATABASE_URL="postgresql://toktickit:toktickit_dev_password@127.0.0.1:5433/toktickit_dev?schema=public"

# --- Option B: embedded PostgreSQL, no Docker at all ---
# Starts a real PostgreSQL from node_modules on port 5434:
#   cd server && npm run db:up
# Then point this URL at it:
# DATABASE_URL="postgresql://toktickit:toktickit_dev_password@127.0.0.1:5434/toktickit_dev?schema=public"
# Stop the embedded DB later with  npm run db:down .

# --- Option B: native / non-Docker Postgres ---
# Install Postgres yourself and set the URL to your own user/password/host/db.
# The DB name below (toktickit_dev) must exist; create it once if needed, e.g.
#   CREATE DATABASE toktickit_dev;
# If your DB listens on the default port with your own credentials:
# DATABASE_URL="postgresql://myuser:mypassword@127.0.0.1:5432/toktickit_dev?schema=public"

PORT=4000
CORS_ORIGIN=http://localhost:5173
