generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum Status {
  NEW
  OPEN
  PENDING
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model Requester {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

// Lab 3 Authentication Foundation (backward-compatible).
// Requester table is intentionally KEPT for Lab 2 regression; Ticket.requesterId
// still points to Requester. User rows are mirrored from Requester in seed.
// Full repoint (Ticket.requesterId -> User, drop Requester/ownerName,
// PENDING -> WAITING_FOR_REQUESTER) happens in a later auth-API migration.
model User {
  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(100)
  email               String    @unique @db.VarChar(255)
  passwordHash        String
  role                Role
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
  ownedTickets        Ticket[]  @relation("TicketOwner")
  publicComments      PublicComment[] @relation("PublicCommentAuthor")
  internalNotes       InternalNote[] @relation("InternalNoteAuthor")
  actionsTaken        ActionTaken[]

  @@index([role, isActive])
  @@index([createdAt(sort: Desc)])
}

// Session per spec §7.4 (AD-01). Simplification documented for auth API layer:
// `id` stores the 64-char hex token directly (32 random bytes, hex-encoded).
// The spec's "stored hashed with SHA-256" is deferred: hashing the id column
// would require a separate lookup column + migration risk now, with zero
// security benefit until login routes exist. When login is implemented, either
// (a) store SHA-256(id) in `id` and use the raw token only in the cookie, or
// (b) add a `tokenHash` column. Cookie: `toktickit.sid`, httpOnly, SameSite=Lax.
model Session {
  id                String   @id @db.VarChar(64)
  userId            Int
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  createdAt         DateTime @default(now())
  ipHash            String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Ticket {
  id            Int      @id @default(autoincrement())
  ticketNumber  String   @unique @db.VarChar(20)
  title         String   @db.VarChar(120)
  description   String?  @db.Text
  status        Status   @default(NEW)
  priority      Priority @default(MEDIUM)
  itPriority    Priority?
  ownerName     String?
  ownerId       Int?
  appearsResolvedAt DateTime?
  requesterId    Int
  categoryId     Int
  relatedSystemId Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Lab 4 (L4-2 foundation): optimistic-concurrency version plus the
  // resolution lifecycle columns (resolvedAt/resolutionSummary are written by
  // the L4-3 workflow; until then they stay null). Additive only.
  version           Int       @default(1)
  resolvedAt        DateTime?
  resolutionSummary String?   @db.VarChar(2000)

  requester    Requester      @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  owner        User?          @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem RelatedSystem @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)
  attachments  Attachment[]
  attachmentEvents AttachmentEvent[]
  publicComments  PublicComment[]
  internalNotes   InternalNote[]
  actions         ActionTaken[]

  @@index([requesterId, createdAt(sort: Desc)])
  @@index([categoryId])
  @@index([priority])
  @@index([relatedSystemId])
  @@index([ownerId])
  @@index([status, createdAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
  // Lab 4 (lab4_actions_taken): staff-dashboard and requester-dashboard
  // predicates; the added itPriority index serves countsByItPriority.
  @@index([ownerId, status])
  @@index([requesterId, updatedAt(sort: Desc)])
  @@index([itPriority])
}

// Lab 3 Public Comments (FR-08/BR-14). Append-only: no update/delete paths
// exist in code or migrations. `body` stores raw text (1..2000 trimmed chars);
// the client escapes HTML on render. `authorId`/`createdAt` are server-derived
// (BR-14) and never accepted from the client.
model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String   @db.VarChar(2000)
  appearsResolved Boolean @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation("PublicCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt(sort: Asc)])
}

// Lab 3 §8 — Internal Notes (FR-09/BR-04). Append-only: no update/delete
// paths exist in code or migrations. `body` stores raw text (1..2000 trimmed
// chars); authorId/createdAt are server-derived (BR-14) and never accepted
// from the client. Requester access is blocked at the route layer with a
// masked 404 (api-spec §1.5) — requesters never read or write this table.
model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation("InternalNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt(sort: Asc)])
}

model Attachment {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  fileName   String
  storedName String   @unique
  mimeType   String
  sizeBytes  Int
  sha256     String?
  removeReason String?
  removeNote   String?
  uploadedAt DateTime @default(now())
  removedAt  DateTime?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model AttachmentEvent {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  attachmentId Int?
  type         String
  actorId      Int?
  actorName    String
  fileName     String
  mimeType     String
  sizeBytes    Int
  sha256       String?
  reason       String?
  note         String?
  createdAt    DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([ticketId, createdAt(sort: Desc)])
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

// Lab 4 — Actions Taken (spec §7.1, FR-01/FR-02). One row belongs to exactly
// one Ticket (Restrict: actions are never deleted or re-parented, BR-01);
// performedById is always server-derived from the session (BR-04). No delete
// endpoint exists (BR-19).
model ActionTaken {
  id              Int      @id @default(autoincrement())
  ticketId        Int
  performedById   Int
  actionAt        DateTime @default(now())
  description     String   @db.VarChar(2000)
  result          String   @db.VarChar(2000)
  followUpRequired Boolean @default(false)
  followUpNote    String?  @db.VarChar(1000)
  attachmentNotes String?  @db.VarChar(500)
  clientRequestId String?  @db.VarChar(64)
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  performedBy User   @relation(fields: [performedById], references: [id], onDelete: Restrict)

  @@index([ticketId, actionAt(sort: Desc), id(sort: Desc)])
  @@index([performedById, createdAt(sort: Desc)])
  @@unique([performedById, clientRequestId])
}
